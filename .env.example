# Application Environment
FLASK_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# Security Secrets (Must be 32+ cryptographically random bytes in production)
SECRET_KEY=dev-insecure-secret-key-change-me-32-bytes-minimum!!
JWT_SECRET_KEY=dev-jwt-secret-key-change-me-to-a-cryptographically-secure-64-byte-key!!
IP_SALT=privacy-salt-for-sha256-ip-anonymization-change-me

# PostgreSQL Database Configuration
POSTGRES_USER=shortener_user
POSTGRES_PASSWORD=shortener_pass
POSTGRES_DB=shortener_db
DATABASE_URL=postgresql://shortener_user:shortener_pass@localhost:5432/shortener_db

# Redis Configuration (Cache, Rate Limiting, Celery Broker)
REDIS_URL=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Cache Tuning
CACHE_DEFAULT_TIMEOUT=86400

# Gunicorn Worker Tuning
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
